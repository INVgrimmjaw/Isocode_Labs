generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All money is integer paise. All percentages are basis points (1800 = 18%).

enum Role {
  RETAILER
  DESK
}

model User {
  id         String    @id @default(cuid())
  phone      String    @unique
  name       String
  role       Role
  retailerId String?
  retailer   Retailer? @relation(fields: [retailerId], references: [id])
  createdAt  DateTime  @default(now())

  sessions Session[]

  @@index([retailerId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Retailer {
  id               String @id @default(cuid())
  code             String @unique
  shopName         String
  ownerName        String
  phone            String @unique
  area             String
  /// The delivery route. Van loading lists are grouped by this.
  beat             String
  tallyLedgerName  String
  creditLimitPaise Int
  /// Billed but unpaid, as last synced from Tally.
  outstandingPaise Int    @default(0)

  users    User[]
  prices   RetailerPrice[]
  orders   Order[]
  captures Capture[]
  aliases  RetailerAlias[]
}

model Brand {
  id   String @id @default(cuid())
  name String @unique
  skus Sku[]
}

model Sku {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  nameHi           String
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id])
  category         String
  /// Groups the pack sizes of one product, so "chhota" can mean the smallest of them.
  family           String
  packLabel        String
  sizeGrams        Int?
  unitsPerCase     Int
  /// Default price per piece, excluding GST. A RetailerPrice row overrides it.
  dealerPricePaise Int
  gstBps           Int
  /// Kept in pieces because loose pieces can be sold from a case.
  stockPieces      Int
  /// Words shopkeepers use for this item, read by the capture matcher.
  keywords         String[]
  packKind         String
  imageUrl         String?
  active           Boolean  @default(true)

  retailerPrices RetailerPrice[]
  schemes        Scheme[]
  orderLines     OrderLine[]
  aliases        RetailerAlias[]

  @@index([category])
}

model RetailerPrice {
  retailerId     String
  skuId          String
  unitPricePaise Int
  retailer       Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sku            Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([retailerId, skuId])
}

enum SchemeKind {
  FREE_GOODS
  SLAB_DISCOUNT
}

model Scheme {
  id        String     @id @default(cuid())
  skuId     String
  sku       Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  kind      SchemeKind
  label     String
  labelHi   String
  /// FREE_GOODS only: buy this many cases to earn freeCases.
  buyCases  Int?
  freeCases Int?
  validFrom DateTime
  /// Exclusive. Null means open-ended.
  validTo   DateTime?

  slabs SchemeSlab[]

  @@index([skuId])
}

model SchemeSlab {
  id          String @id @default(cuid())
  schemeId    String
  scheme      Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  minCases    Int
  discountBps Int

  @@unique([schemeId, minCases])
}

enum OrderStatus {
  CREDIT_HOLD
  READY
  EXPORTED
  REJECTED
}

enum OrderSource {
  APP
  AI_CAPTURE
}

model Order {
  id             String      @id @default(cuid())
  number         Int         @unique @default(autoincrement())
  retailerId     String
  retailer       Retailer    @relation(fields: [retailerId], references: [id])
  placedById     String
  status         OrderStatus
  source         OrderSource
  /// Scoped to the retailer so a retried request on a bad connection cannot create a second order.
  idempotencyKey String?     @unique

  grossPaise    Int
  discountPaise Int
  taxablePaise  Int
  gstPaise      Int
  totalPaise    Int

  /// How far over the limit the order was when it was held.
  overLimitPaise Int?
  rejectedReason String?
  decidedById    String?
  decidedAt      DateTime?

  tallyBatchId String?
  tallyBatch   TallyBatch? @relation(fields: [tallyBatchId], references: [id])
  exportedAt   DateTime?

  createdAt DateTime @default(now())

  lines   OrderLine[]
  capture Capture?

  @@index([retailerId, createdAt])
  @@index([status, createdAt])
}

/// A priced snapshot. Later price or scheme edits must never change a placed order.
model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId          String
  sku            Sku     @relation(fields: [skuId], references: [id])
  skuCode        String
  skuName        String
  unitsPerCase   Int
  cases          Int
  pieces         Int
  totalPieces    Int
  freeCases      Int     @default(0)
  unitPricePaise Int
  gstBps         Int
  grossPaise     Int
  discountPaise  Int
  taxablePaise   Int
  gstPaise       Int
  totalPaise     Int
  schemeLabel    String?
  schemeKind     SchemeKind?

  @@index([orderId])
  @@index([skuId])
}

model TallyBatch {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  createdById String
  orderCount  Int
  totalPaise  Int
  xml         String
  createdAt   DateTime @default(now())

  orders Order[]
}

enum CaptureChannel {
  WHATSAPP
  APP
}

enum CaptureStatus {
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

enum CaptureEngine {
  CLAUDE
  MATCHER
}

model Capture {
  id          String         @id @default(cuid())
  retailerId  String
  retailer    Retailer       @relation(fields: [retailerId], references: [id])
  channel     CaptureChannel
  rawText     String
  status      CaptureStatus  @default(NEEDS_REVIEW)
  engine      CaptureEngine
  /// Why the matcher ran instead of Claude, shown to the desk.
  engineNote  String?
  decidedById String?
  decidedAt   DateTime?
  orderId     String?        @unique
  order       Order?         @relation(fields: [orderId], references: [id])
  /// The mock WhatsApp reply, including any lines left out.
  replyText   String?
  createdAt   DateTime       @default(now())

  lines CaptureLine[]

  @@index([status, createdAt])
  @@index([retailerId, createdAt])
}

enum CaptureUnit {
  CASE
  PIECE
  UNCLEAR
}

enum LineDecision {
  ACCEPTED
  CORRECTED
  DROPPED
}

model CaptureLine {
  id                String        @id @default(cuid())
  captureId         String
  capture           Capture       @relation(fields: [captureId], references: [id], onDelete: Cascade)
  position          Int
  originalWords     String
  /// Original words without quantity and unit. The key an alias is learned under.
  phrase            String
  quantity          Int?
  unit              CaptureUnit
  suggestedSkuId    String?
  confidence        Float
  reason            String
  alternativeSkuIds String[]
  flags             String[]
  finalSkuId        String?
  finalQuantity     Int?
  finalUnit         CaptureUnit?
  decision          LineDecision?

  @@unique([captureId, position])
}

/// What a desk correction teaches: "when this shop says X, they mean this SKU".
model RetailerAlias {
  id          String   @id @default(cuid())
  retailerId  String
  retailer    Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  phrase      String
  skuId       String
  sku         Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdById String
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([retailerId, phrase])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
