{
  "name": "peti",
  "version": "1.0.0",
  "private": true,
  "description": "Retailer ordering app with AI order capture for an FMCG distributor.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config client/vite.config.ts",
    "build:api": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js --sourcemap",
    "start": "node --enable-source-maps dist/server.js",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "npm run db:deploy && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "preact": "11.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wouter-preact": "3.13.0"
  }
}
