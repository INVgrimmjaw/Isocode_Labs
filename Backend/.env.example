# Copy to .env. The values below are safe local defaults that match docker-compose.yml.

DATABASE_URL=postgresql://peti@localhost:5433/peti

# Only used by `npm test`. This database is wiped on every run, so never point it at real data.
TEST_DATABASE_URL=postgresql://peti@localhost:5433/peti_test

# Signs OTP hashes. Any long random string: `openssl rand -hex 32`. Required.
OTP_SECRET=

# Optional. Without it, order capture falls back to the built-in matcher and the desk is told.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
AI_MODEL=

# "true" shows the OTP on the sign-in screen, because SMS is mocked. Never enable with real users.
DEMO_MODE=true

PORT=4000
